# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-system build output (regenerated by `npm run build` in the package)
/packages/femora-ds/dist

# design-sync: staged converter scripts, build output, and machine state.
# Durable inputs (config.json, conventions.md, NOTES.md, previews/, overrides/) ARE committed.
/.ds-sync
/ds-bundle
/.design-sync/.cache
/.design-sync/learnings
/.design-sync/node_modules
